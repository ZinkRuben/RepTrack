# Az első adminisztrátor adatai. Csak akkor számítanak, amikor még nincs adminisztrátor (üres adatbázis).
# Másold ezt a fájlt .env néven, és a jelszót cseréld saját, legalább 8 karakteres jelszóra:
# a CHANGE-ME mintaértékkel az alkalmazás nem indul el.
REPTRACK_ADMIN_EMAIL=admin@reptrack.com
REPTRACK_ADMIN_PASSWORD=CHANGE-ME
REPTRACK_ADMIN_NAME=Adminisztrátor

# Demófelhasználó 16 hétnyi mintaadattal (edzések, testtömeg, célok, sablonok, csúcsok, figyelmeztetések).
# true esetén induláskor jön létre, ha még nincs; a meglévőt nem írja felül (újra: a fiók törlése és újraindítás).
# Belépés: demo@reptrack.com / demo1234 (a jelszó szándékosan nyilvános, csak bemutatáshoz)
REPTRACK_DEMO_ENABLED=false
